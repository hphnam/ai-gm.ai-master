generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model Venue {
  id        String   @id @default(uuid())
  name      String
  address   String?
  type      String
  timezone  String   @default("Europe/London")
  createdAt DateTime @default(now())

  mockStock         MockStock[]
  knowledgeItems    KnowledgeItem[]
  mockPurchaseOrders MockPurchaseOrder[]
  contacts          VenueContact[]
}

/// TEMPORARY — replaced by Xero/Square integration in a later milestone
model MockSupplier {
  id           String   @id @default(uuid())
  name         String
  contactName  String?
  email        String?
  phone        String?
  leadTimeDays Int      @default(2)
  notes        String?
  createdAt    DateTime @default(now())

  mockStock          MockStock[]
  mockPurchaseOrders MockPurchaseOrder[]

  @@map("mock_suppliers")
}

/// TEMPORARY — replaced by Xero/Square integration in a later milestone
model MockStockCategory {
  id   String @id @default(uuid())
  name String @unique

  mockStock MockStock[]

  @@map("mock_stock_categories")
}

/// TEMPORARY — replaced by Xero/Square integration in a later milestone
model MockStock {
  id             String   @id @default(uuid())
  venueId        String
  supplierId     String?
  categoryId     String
  name           String
  sku            String?
  unit           String
  unitSize       String?
  currentQty     Decimal
  parLevel       Decimal
  reorderQty     Decimal
  costPerUnit    Decimal?
  avgWeeklyUsage Decimal?
  notes          String?

  embedding     Unsupported("vector(1024)")?
  embeddingText String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue                  Venue                   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  supplier               MockSupplier?           @relation(fields: [supplierId], references: [id])
  category               MockStockCategory       @relation(fields: [categoryId], references: [id])
  mockPurchaseOrderItems MockPurchaseOrderItem[]

  @@index([venueId])
  @@index([categoryId])
  @@map("mock_stock")
}

/// TEMPORARY — replaced by Xero/Square integration in a later milestone
model MockPurchaseOrder {
  id         String    @id @default(uuid())
  venueId    String
  supplierId String
  status     String    @default("draft")
  orderedAt  DateTime?
  expectedAt DateTime?
  receivedAt DateTime?
  notes      String?
  createdAt  DateTime  @default(now())

  venue    Venue                   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  supplier MockSupplier            @relation(fields: [supplierId], references: [id])
  items    MockPurchaseOrderItem[]

  @@map("mock_purchase_orders")
}

/// TEMPORARY — replaced by Xero/Square integration in a later milestone
model MockPurchaseOrderItem {
  id          String   @id @default(uuid())
  poId        String
  stockItemId String
  qtyOrdered  Decimal
  qtyReceived Decimal?
  unitCost    Decimal?

  purchaseOrder MockPurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  mockStock     MockStock         @relation(fields: [stockItemId], references: [id])

  @@map("mock_purchase_order_items")
}

model KnowledgeItem {
  id        String   @id @default(uuid())
  venueId   String?
  content   String
  metadata  Json     @default("{}")
  embedding Unsupported("vector(1024)")?
  embeddingText String?
  aiSummary String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue Venue? @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@map("knowledge_items")
}

model VenueContact {
  id                 String  @id @default(uuid())
  venueId            String
  name               String
  role               String
  phone              String?
  email              String?
  isEmergencyContact Boolean @default(false)
  notes              String?

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
}

model ChatConversation {
  id        String   @id @default(uuid())
  venueId   String
  userId    String?
  channel   String   @default("web")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]
}

model ChatMessage {
  id               String   @id @default(uuid())
  conversationId   String
  role             String
  content          String
  retrievedItemIds String[]
  toolCallLog      Json     @default("[]")
  createdAt        DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}
