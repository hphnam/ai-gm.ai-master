generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model Venue {
  id             String   @id @default(uuid())
  name           String
  address        String?
  type           String
  timezone       String   @default("Europe/London")
  organizationId String
  createdAt      DateTime @default(now())

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  mockStock          MockStock[]
  knowledgeItems     KnowledgeItem[]
  mockPurchaseOrders MockPurchaseOrder[]
  contacts           VenueContact[]
  chatConversations  ChatConversation[]

  @@index([organizationId])
}

// ──────────────────────────────────────────────────────────────────
// v0.2 Phase 1 — Auth + Organizations (better-auth managed)
// ──────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  emailVerified   Boolean   @default(false)
  name            String?
  image           String?
  phoneNumber     String?   @unique
  phoneVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions    Session[]
  accounts    Account[]
  memberships OrganizationMember[]
  invitesSent Invitation[]         @relation("inviter")

  @@map("users")
}

model Session {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token                String   @unique
  expiresAt            DateTime
  ipAddress            String?
  userAgent            String?
  activeOrganizationId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  password              String?
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model VerificationToken {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification_tokens")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  logo      String?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members        OrganizationMember[]
  invitations    Invitation[]
  venues         Venue[]
  knowledgeItems KnowledgeItem[]

  @@index([slug])
  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("organization_members")
}

model Invitation {
  id             String       @id @default(uuid())
  email          String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String
  status         String       @default("pending")
  inviterId      String
  inviter        User         @relation("inviter", fields: [inviterId], references: [id])
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  @@index([email])
  @@index([organizationId])
  @@map("invitations")
}

/// TEMPORARY — replaced by Xero/Square integration in a later milestone
model MockSupplier {
  id           String   @id @default(uuid())
  name         String
  contactName  String?
  email        String?
  phone        String?
  leadTimeDays Int      @default(2)
  notes        String?
  createdAt    DateTime @default(now())

  mockStock          MockStock[]
  mockPurchaseOrders MockPurchaseOrder[]

  @@map("mock_suppliers")
}

/// TEMPORARY — replaced by Xero/Square integration in a later milestone
model MockStockCategory {
  id   String @id @default(uuid())
  name String @unique

  mockStock MockStock[]

  @@map("mock_stock_categories")
}

/// TEMPORARY — replaced by Xero/Square integration in a later milestone
model MockStock {
  id             String   @id @default(uuid())
  venueId        String
  supplierId     String?
  categoryId     String
  name           String
  sku            String?
  unit           String
  unitSize       String?
  currentQty     Decimal
  parLevel       Decimal
  reorderQty     Decimal
  costPerUnit    Decimal?
  avgWeeklyUsage Decimal?
  notes          String?

  embedding     Unsupported("vector(1024)")?
  embeddingText String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue                  Venue                   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  supplier               MockSupplier?           @relation(fields: [supplierId], references: [id])
  category               MockStockCategory       @relation(fields: [categoryId], references: [id])
  mockPurchaseOrderItems MockPurchaseOrderItem[]

  @@index([venueId])
  @@index([categoryId])
  @@map("mock_stock")
}

/// TEMPORARY — replaced by Xero/Square integration in a later milestone
model MockPurchaseOrder {
  id         String    @id @default(uuid())
  venueId    String
  supplierId String
  status     String    @default("draft")
  orderedAt  DateTime?
  expectedAt DateTime?
  receivedAt DateTime?
  notes      String?
  createdAt  DateTime  @default(now())

  venue    Venue                   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  supplier MockSupplier            @relation(fields: [supplierId], references: [id])
  items    MockPurchaseOrderItem[]

  @@map("mock_purchase_orders")
}

/// TEMPORARY — replaced by Xero/Square integration in a later milestone
model MockPurchaseOrderItem {
  id          String   @id @default(uuid())
  poId        String
  stockItemId String
  qtyOrdered  Decimal
  qtyReceived Decimal?
  unitCost    Decimal?

  purchaseOrder MockPurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  mockStock     MockStock         @relation(fields: [stockItemId], references: [id])

  @@map("mock_purchase_order_items")
}

model KnowledgeItem {
  id             String   @id @default(uuid())
  organizationId String
  venueId        String?
  content        String
  metadata       Json     @default("{}")
  embedding      Unsupported("vector(1024)")?
  embeddingText  String?
  aiSummary      String?
  // Plan 04-01 Task 3 — image-via-Claude-vision source persistence (audit-S3 Option A committed).
  // Additive nullable columns; all pre-Phase-4 rows keep NULL for both. Image bytes are stored
  // inline for POC scale (≤500 uploads × 5MB cap = ≤2.5GB aggregate — NeonDB storage non-issue).
  // Object-storage migration deferred as D-04-01-F with concrete trigger in SUMMARY.
  sourceImageBytes Bytes?
  sourceImageMime  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  venue           Venue?           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  retagQueueItems ReTagQueueItem[]

  @@index([organizationId])
  @@index([venueId])
  @@map("knowledge_items")
}

model VenueContact {
  id                 String  @id @default(uuid())
  venueId            String
  name               String
  role               String
  phone              String?
  email              String?
  isEmergencyContact Boolean @default(false)
  notes              String?

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
}

model ChatConversation {
  id        String   @id @default(uuid())
  venueId   String
  userId    String?
  channel   String   @default("web")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue    Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([venueId])
}

model ChatMessage {
  id               String   @id @default(uuid())
  conversationId   String
  role             String
  content          String
  retrievedItemIds String[]
  toolCallLog      Json     @default("[]")
  createdAt        DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  feedback        MessageFeedback?
  retagQueueItems ReTagQueueItem[] @relation("sourceMessage")
}

model MessageFeedback {
  id           String   @id @default(uuid())
  messageId    String   @unique
  kind         String
  userFeedback String?
  createdAt    DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("message_feedback")
}

model ReTagQueueItem {
  id              String   @id @default(uuid())
  knowledgeItemId String
  reason          String
  status          String   @default("queued")
  sourceMessageId String?
  attempts        Int      @default(0)
  lastError       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  knowledgeItem KnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)
  sourceMessage ChatMessage?  @relation("sourceMessage", fields: [sourceMessageId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([knowledgeItemId, status])
  @@index([sourceMessageId])
  @@map("retag_queue_items")
}
