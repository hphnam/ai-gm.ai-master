# Dependencies
node_modules/

# Build outputs
dist/
.next/
out/
*.tsbuildinfo

# Canary fixtures — POS exports + beerhall xlsx are test inputs only,
# never to be tracked (real venue revenue / payroll / customer data).
docs/*.xlsx
docs/*.csv
docs/*.tsv

# Turbo
.turbo/

# Environment
.env
.env.local
.env.*.local

# Prisma
packages/database/src/generated/

# Swagger / OpenAPI codegen — committed so deploys don't have to run
# the regen pipeline. Refresh with:
#   pnpm --filter api swagger:generate && pnpm --filter web api:generate
# Treat the diff like a Prisma migration — review before push.

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Debug
npm-debug.log*
pnpm-debug.log*
.paul/automation-logs/
CLAUDE.local.md

# agentmemory runtime state — a running process's store, not a project artefact.
# Tracked by accident and never present in a brain commit; untracked 2026-08-07.
# These are binary and rewritten on every save, so committing them puts noise in
# every future diff. The durable record lives in brain/ledger/ and brain/log/.
data/state_store.db/
data/stream_store/

# Raw exports must never sit at the repository ROOT. S37 removed two that did —
# `items-2024-01-01-2026-06-01.csv` and `Elliot's AI-GM Questions - Query result.csv`
# — which were later moved into brain/data/ but stayed in history at the root path,
# sharing a blob with the copies there. Root-anchored with a leading slash, so
# fixtures nested under apps/, docs/ and brain/ keep their own rules.
/*.csv
/*.xlsx
/*.xls
/*.parquet
/*.duckdb
/*.sqlite
/*.sqlite3
/*.db

# Third-party exemplar dissertation, kept local. This remote is PUBLIC (verified
# 2026-08-18), and the file is someone else's work; the other brain/docs entries
# are issued guidance about the course, which is a different thing to redistribute.
brain/docs/Sample Dissertation.*
