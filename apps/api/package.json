{
  "name": "api",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/src/main",
    "start:prod": "node dist/src/main",
    "seed": "nest build && node dist/src/seed.js seed",
    "probe:embeddings": "tsx scripts/probe-embeddings.ts",
    "probe:seed": "tsx scripts/probe-seed.ts",
    "probe:ingest": "nest build && node dist/src/scripts/probe-ingest.js",
    "probe:retrieval": "nest build && node dist/src/scripts/probe-retrieval.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "@gm-ai/database": "workspace:*",
    "@gm-ai/types": "workspace:*",
    "@nestjs/common": "latest",
    "@nestjs/core": "latest",
    "@nestjs/platform-express": "latest",
    "dotenv": "latest",
    "nest-commander": "latest",
    "reflect-metadata": "latest",
    "rxjs": "latest",
    "voyageai": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@nestjs/cli": "latest",
    "@swc/cli": "latest",
    "@swc/core": "latest",
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
