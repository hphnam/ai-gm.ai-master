{
  "name": "api",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/src/main",
    "start:prod": "node dist/src/main",
    "seed": "nest build && node dist/src/seed.js seed",
    "probe:embeddings": "tsx scripts/probe-embeddings.ts",
    "probe:seed": "tsx scripts/probe-seed.ts",
    "probe:ingest": "nest build && node dist/src/scripts/probe-ingest.js",
    "probe:retrieval": "nest build && node dist/src/scripts/probe-retrieval.js",
    "probe:chat": "nest build && node dist/src/scripts/probe-chat.js",
    "probe:suggestions": "nest build && node dist/src/scripts/probe-suggestions.js",
    "probe:adaptation": "nest build && node dist/src/scripts/probe-adaptation.js",
    "probe:eval": "nest build && node dist/src/scripts/probe-eval.js",
    "probe:api": "nest build && node dist/src/scripts/probe-api.js",
    "probe:auth": "nest build && node dist/src/scripts/probe-auth.js",
    "migrate:phase-1-data": "tsx scripts/migrate-phase-1-data.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "@gm-ai/database": "workspace:*",
    "@gm-ai/types": "workspace:*",
    "@nestjs/common": "latest",
    "@nestjs/core": "latest",
    "@nestjs/platform-express": "latest",
    "better-auth": "^1.6.5",
    "dotenv": "latest",
    "express": "latest",
    "kysely": "^0.28.16",
    "nest-commander": "latest",
    "reflect-metadata": "latest",
    "rxjs": "latest",
    "voyageai": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.21",
    "@nestjs/cli": "latest",
    "@swc/cli": "latest",
    "@swc/core": "latest",
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
