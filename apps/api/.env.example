# apps/api — NestJS backend env. In production the deploy platform injects these.

# ── Core ──────────────────────────────────────────────
DATABASE_URL=                              # Postgres connection string (Neon)
REDIS_URL=redis://127.0.0.1:6379           # rediss:// for TLS (DO managed Redis)
NODE_ENV=development
PORT=3001

# ── Auth (better-auth) ────────────────────────────────
BETTER_AUTH_SECRET=                        # openssl rand -hex 32  (64 hex chars)
BETTER_AUTH_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000           # comma-separate for multiple origins
PUBLIC_APP_URL=http://localhost:3000       # builds invite / SMS onboarding links (must be publicly reachable)

# ── AI / knowledge pipeline ───────────────────────────
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
REDUCTO_API_KEY=
# REDUCTO_BASE_URL=                        # optional override

# ── External lookups ──────────────────────────────────
# Google Places API (New) key — create at console.cloud.google.com (enable "Places API (New)").
# Optional: leave empty to disable business lookup during onboarding.
GOOGLE_MAPS_API_KEY=

# ── Integration credential encryption ─────────────────
INTEGRATION_TOKEN_KEY=                     # hex:<64hex> | base64:<44b64> — openssl rand -hex 32

# ── Email (Plunk over SMTP) — all 5 required together, or omit for console ──
SMTP_HOST=next-smtp.useplunk.com
SMTP_PORT=2587
SMTP_USER=plunk
SMTP_PASSWORD=                             # Plunk secret key
MAIL_FROM="GM AI <no-reply@yourdomain>"
# MAIL_DRIVER_OVERRIDE=console             # force console mode (probes only)

# ── Twilio ────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Phone-OTP login + invite SMS (what the app uses today). The 5-digit PIN is
# self-generated and delivered over SMS, so SMS_SENDER is required in production.
TWILIO_SMS_SENDER=                         # +E164 sender number (required in production)
TWILIO_VERIFY_SERVICE_SID=                 # VA...  (optional — no longer used for login)
# WhatsApp (Meta-blocked for now — leave empty until enabled)
TWILIO_CONVERSATIONS_SERVICE_SID=
TWILIO_WHATSAPP_SENDER=
PUBLIC_WEBHOOK_URL=                        # https URL registered in Twilio console
# Driver overrides — "live" to send for real, "console"/"disabled" for dev. Never console in prod.
TWILIO_DRIVER_OVERRIDE=console
PHONE_VERIFY_DRIVER_OVERRIDE=console
# In console/disabled mode the OTP SMS isn't delivered — read the generated code
# from the API logs (the full SMS body is logged).

# ── Optional ──────────────────────────────────────────
# WHATSAPP_MEDIA_HOST_ALLOWLIST=
# Background-job kill-switches (=1 to disable):
# NUDGE_CRON_DISABLED  TASK_REMINDER_CRON_DISABLED  EXPIRY_SCHEDULER_DISABLED
# EXPIRY_EXTRACTOR_DISABLED  CHAT_STARTERS_CRON_DISABLED  SCHEDULED_REPORTS_CRON_DISABLED
# MEMORY_RECONCILE_CRON_DISABLED  MEMORY_RECONCILE_GENERATOR_DISABLED
# DOC_RECONCILE_DISABLED  AGENT_MEMORY_DISABLED  NOTE_DIGEST_CRON_DISABLED
