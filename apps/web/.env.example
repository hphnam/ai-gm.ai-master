# apps/web — Next.js browser bundle env (NEXT_PUBLIC_* only).
# Next.js auto-loads .env from this directory. Production sets these in the
# deploy platform. NEXT_PUBLIC_WEB_ORIGIN must also appear in the API's
# WEB_ORIGIN allowlist for CORS + better-auth trustedOrigins.

NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
