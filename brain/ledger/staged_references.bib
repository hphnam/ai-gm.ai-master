	title = {Parameter-Free and Group Conditional Online Conformal Prediction},
	author = {Bharti, Beepul and Pal, Ambar and Teneggi, Jacopo and Sulam, Jeremias},
	date = {2026-07-07},
	number = {arXiv:2606.00419},
	publisher = {arXiv},
	doi = {10.48550/arXiv.2606.00419},
