DATABASE_URL=postgresql://user:password@host:5432/gm_ai
NODE_ENV=development
PORT=3001

ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=pa-...

WEB_ORIGIN=http://localhost:3000
# Comma-separate for multiple origins. Used for CORS + better-auth trustedOrigins.

NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WEB_ORIGIN=http://localhost:3000

# Auth
BETTER_AUTH_SECRET=<generate-with-openssl-rand-hex-32>
# Generate: `openssl rand -hex 32`. Must be exactly 64 hex chars.
BETTER_AUTH_URL=http://localhost:3001

# Email (optional — omit for dev console fallback)
RESEND_API_KEY=
MAIL_FROM="GM AI <onboarding@example.dev>"
# Required when RESEND_API_KEY is set. Format: "Name <addr@domain>".
MAIL_DRIVER_OVERRIDE=
# Set to "console" to force console mode. Used by probe-auth.ts.

# SMS (Twilio Verify, Plan 01-03 — all three required together, or all absent for console fallback)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Force a specific driver: "disabled" (kill-switch → 503), "console" (deterministic local codes), or unset.
TWILIO_DRIVER_OVERRIDE=console

# WhatsApp (Twilio) — Phase 3 Plan 01
# Production: set TWILIO_WHATSAPP_FROM to your Twilio WhatsApp sender (format: whatsapp:+14155551234)
# Reuses TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN from phone verification above.
# TWILIO_WHATSAPP_DRIVER_OVERRIDE:
#   console  — log outbound only, never hit Twilio (dev default)
#   live     — real Twilio WhatsApp sender (requires Meta Business verification)
#   disabled — kill-switch: inbound acks with 200 but no outbound reply
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_DRIVER_OVERRIDE=console

# WHATSAPP_WEBHOOK_PUBLIC_URL (audit-added M1):
# EXACT https URL Twilio posts to. Signature validation pins against this string —
# rejects X-Forwarded-Host / X-Forwarded-Proto spoofing. Required whenever
# TWILIO_WHATSAPP_FROM is set and driver override != "console".
WHATSAPP_WEBHOOK_PUBLIC_URL=

# ALLOW_WEBHOOK_DEV_BYPASS (audit-added M2):
# Set to "true" ONLY in local dev with NODE_ENV != production. Enables the
# X-Twilio-Signature: probe-console manual-curl bypass for signature validation.
# Boot FAILS if "true" + NODE_ENV=production. MUST be unset before Phase 4 cutover (D-03-01-F).
ALLOW_WEBHOOK_DEV_BYPASS=
