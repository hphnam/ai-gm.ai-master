# ──────────────────────────────────────────────────────────────────
# Core
# ──────────────────────────────────────────────────────────────────

DATABASE_URL=postgresql://user:password@host:5432/gm_ai
# Postgres connection string. NeonDB in prod, local Postgres or Neon
# dev branch for local dev. Must be reachable at boot — prisma adapter
# fails fast on bad URL.

NODE_ENV=development
# development | production. Production trips stricter gates: seed
# refuses default password, email-verification gate is enforced on
# invitation accept (D-01-02-F), cookies get secure=true, etc.

PORT=3001
# API server port. Web app defaults to 3000 (set via its own dev script).

# ──────────────────────────────────────────────────────────────────
# AI services
# ──────────────────────────────────────────────────────────────────

ANTHROPIC_API_KEY=sk-ant-...
# Claude API key. Used by chat engine + knowledge-doc enrichment +
# proactive suggestions. Model pinned to claude-sonnet-4-6.

VOYAGE_API_KEY=pa-...
# Voyage AI key for embeddings (voyage-3 model). Used by retrieval
# service + knowledge-doc ingest.

# ──────────────────────────────────────────────────────────────────
# Web / CORS
# ──────────────────────────────────────────────────────────────────

WEB_ORIGIN=http://localhost:3000
# CORS allowlist for the API + better-auth trustedOrigins. Comma-
# separate for multiple origins (e.g. prod + preview). The API fails
# to boot if missing (assertAuthEnv M8).

# ──────────────────────────────────────────────────────────────────
# Web client (Next.js — must be prefixed NEXT_PUBLIC_ to reach browser)
# ──────────────────────────────────────────────────────────────────

NEXT_PUBLIC_API_URL=http://localhost:3001
# Base URL the web app calls for every apiFetch. In prod this is the
# api's public HTTPS URL.

NEXT_PUBLIC_WEB_ORIGIN=http://localhost:3000
# The web app's own origin (used for building absolute links in emails,
# redirect sanitization, etc.). Mirrors WEB_ORIGIN but exposed to the
# browser bundle.

# ──────────────────────────────────────────────────────────────────
# Auth (better-auth — Plan 01-01)
# ──────────────────────────────────────────────────────────────────

BETTER_AUTH_SECRET=<generate-with-openssl-rand-hex-32>
# 32-byte hex string used to sign session cookies.
# Generate: `openssl rand -hex 32`
# API refuses to boot if missing or not exactly 64 hex chars (M8).
# NEVER commit a real value to this file.

BETTER_AUTH_URL=http://localhost:3001
# Base URL where better-auth endpoints live (the API app).
# In prod, this is the API's public HTTPS URL.

# ──────────────────────────────────────────────────────────────────
# Email (Resend — Plan 01-02 Invitations)
# ──────────────────────────────────────────────────────────────────

RESEND_API_KEY=
# Optional. Omit for dev console-driver fallback — invite URLs log to
# API server stdout instead of being sent.
# When set, MAIL_FROM is required and validated at boot.

MAIL_FROM="GM AI <onboarding@example.dev>"
# Required when RESEND_API_KEY is set. Format: "Name <addr@domain>".
# Malformed format → assertAuthEnv fails fast at boot (M1).

MAIL_DRIVER_OVERRIDE=
# Optional. Set to "console" to force console mode regardless of
# RESEND_API_KEY presence. Used by probe-auth.ts to prevent real
# email sends during probe runs (audit-added M10).

# ──────────────────────────────────────────────────────────────────
# SMS (Twilio Verify — Plan 01-03 Phone linking)
# ──────────────────────────────────────────────────────────────────
# All-or-nothing: either all three Twilio vars are set (→ live driver),
# or all three are unset (→ console-driver fallback, code logs to API
# stdout). Partial config → fail-fast at boot.

TWILIO_ACCOUNT_SID=
# Twilio Account SID. Starts with "AC" and is exactly 34 chars.
# Fetch: https://console.twilio.com/ → Account SID

TWILIO_AUTH_TOKEN=
# Twilio Auth Token. Rotate periodically; never log this value
# (01-01 M7 redaction contract applies).

TWILIO_VERIFY_SERVICE_SID=
# Twilio Verify Service SID. Starts with "VA" and is exactly 34 chars.
# Create: Twilio Console → Verify → Services → Create

TWILIO_DRIVER_OVERRIDE=
# Optional. Three modes (precedence order):
#   "disabled" — kill-switch: every send/verify returns 503
#                phone-service-unavailable. Ops lever (audit-added M3).
#   "console"  — force console driver regardless of live creds set.
#                Use for probe-auth.ts and local dev without burning
#                Twilio credits.
#   unset      — use live driver if all three Twilio vars are set,
#                else console-driver fallback.
