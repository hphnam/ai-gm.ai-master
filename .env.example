# Database
DATABASE_URL=postgresql://user:password@host:5432/gm_ai

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI
VOYAGE_API_KEY=pa-...

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# App
NODE_ENV=development
PORT=3001

# Web origin (CORS allowlist + better-auth trustedOrigins). Comma-separated for multiple.
WEB_ORIGIN=http://localhost:3000

# ──────────────────────────────────────────────────────────────────
# v0.2 Phase 1 — Auth + Organizations
# ──────────────────────────────────────────────────────────────────

BETTER_AUTH_SECRET=<generate-with-openssl-rand-hex-32>
# 32-byte hex string used by better-auth to sign session cookies.
# Generate locally: `openssl rand -hex 32`
# The api fails to boot if missing or not exactly 64 hex chars (audit-added M8).
# NEVER commit a real value to this file.

BETTER_AUTH_URL=http://localhost:3001
# Base URL where better-auth endpoints live (the api app).
# In production, this is the api's public HTTPS URL (Phase 4).
# The api fails to boot if missing (audit-added M8).

DEMO_USER_EMAIL=ryan@ryanhelmn.dev
# Demo org owner for local dev; created by pnpm seed when SEED_DEMO=true AND NODE_ENV!=production.

DEMO_USER_PASSWORD=demo-CHANGE-me-before-prod-Xk7t9
# Demo user password for local dev ONLY. The seed refuses to run in production with this default.
# (audit-added M4)

SEED_DEMO=true
# If true, pnpm seed creates Demo Organization + Crown/Anchor venues. Set to false
# in production to skip demo seed. In production + true + default password → seed exits 1.
