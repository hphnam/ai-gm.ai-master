# Database
DATABASE_URL=postgresql://user:password@host:5432/gm_ai

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Voyage AI
VOYAGE_API_KEY=pa-...

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# App
NODE_ENV=development
PORT=3001

# Web origin (CORS allowlist + better-auth trustedOrigins). Comma-separated for multiple.
WEB_ORIGIN=http://localhost:3000

# ──────────────────────────────────────────────────────────────────
# v0.2 Phase 1 — Auth + Organizations
# ──────────────────────────────────────────────────────────────────

BETTER_AUTH_SECRET=<generate-with-openssl-rand-hex-32>
# 32-byte hex string used by better-auth to sign session cookies.
# Generate locally: `openssl rand -hex 32`
# The api fails to boot if missing or not exactly 64 hex chars (audit-added M8).
# NEVER commit a real value to this file.

BETTER_AUTH_URL=http://localhost:3001
# Base URL where better-auth endpoints live (the api app).
# In production, this is the api's public HTTPS URL (Phase 4).
# The api fails to boot if missing (audit-added M8).

# ──────────────────────────────────────────────────────────────────
# v0.2 Phase 1 — Invitations (Plan 01-02)
# ──────────────────────────────────────────────────────────────────

RESEND_API_KEY=
# Optional. Omit for dev console fallback (invite URL logs to API server stdout).
# When set, MAIL_FROM is required and validated at boot.

MAIL_FROM="GM AI <onboarding@example.dev>"
# Required when RESEND_API_KEY is set. Format: "Name <addr@domain>".
# Malformed format → assertAuthEnv fails fast at boot (audit-added M1).

# MAIL_DRIVER_OVERRIDE (optional)
# Set to "console" to force console mode regardless of RESEND_API_KEY presence.
# Used by probe-auth.ts to prevent real email sends during probe runs (audit-added M10).
MAIL_DRIVER_OVERRIDE=
