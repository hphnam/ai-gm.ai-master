{"nodes": [{"id": "brain_signals_briefing_proactive_briefing", "label": "Proactive briefing \u2014 ranked, de-duplicated, attributed daily feed (L1)", "file_type": "document", "source_file": "brain/signals/briefing.md", "source_location": "lines 1-5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Composes point deviation, change-point, stock cover, checklist and chat-log KB-gap signals into one feed so an operator sees one ranked list rather than five competing alert streams."}, {"id": "brain_signals_briefing_ranking_score", "label": "Transparent briefing rank score (source x severity x recency x novelty x baseline_trust x direction)", "file_type": "rationale", "source_file": "brain/signals/briefing.md", "source_location": "line 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ranking is a product of named, inspectable factors rather than a learned score, so an operator can see why an item outranked another."}, {"id": "brain_signals_briefing_change_point_absorption", "label": "Change-point absorbs the deviation run and coincident stock flag", "file_type": "rationale", "source_file": "brain/signals/briefing.md", "source_location": "line 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "De-duplication rule: a sustained shift is the parent explanation of the daily deviations underneath it, so surfacing both would report the same event many times."}, {"id": "brain_signals_briefing_correlational_attribution", "label": "Correlational attribution \u2014 'coincides with', never 'caused by'", "file_type": "rationale", "source_file": "brain/signals/briefing.md", "source_location": "line 5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Attribution against the exogenous seam is observational, so the wording is deliberately held to coincidence to avoid asserting causation the design cannot support."}, {"id": "brain_signals_briefing_sop_kb_gap_signal", "label": "Chat-log KB-gap (sop) signal \u2014 missing-SOP detection from unanswered repeats", "file_type": "concept", "source_file": "brain/signals/briefing.md", "source_location": "lines 17-19,22", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Repeated unanswered questions (density 0.60 vs baseline 0.19) are read as a missing SOP rather than a chat failure; kept live and separate from the deviation feed."}, {"id": "brain_signals_briefing_dormant_closure_exclusion", "label": "Dormant-venue and non-live-data exclusions from the feed", "file_type": "rationale", "source_file": "brain/signals/briefing.md", "source_location": "line 22", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two River Taps is closed so its closure is dormant and generates no routine deviation items; checklist data is template-only, not live, so it is excluded rather than reported as if real."}], "edges": [{"source": "brain_signals_briefing_proactive_briefing", "target": "brain_signals_change_point_a13_change_point_detection", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brain/signals/briefing.md", "source_location": "line 5", "weight": 1.0}, {"source": "brain_signals_briefing_proactive_briefing", "target": "brain_signals_stock_inventory_a12_days_of_cover", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brain/signals/briefing.md", "source_location": "lines 5,10", "weight": 1.0}, {"source": "brain_signals_briefing_proactive_briefing", "target": "brain_signals_briefing_sop_kb_gap_signal", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brain/signals/briefing.md", "source_location": "lines 5,17-19,22", "weight": 1.0}, {"source": "brain_signals_briefing_ranking_score", "target": "brain_signals_briefing_proactive_briefing", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brain/signals/briefing.md", "source_location": "line 5", "weight": 1.0}, {"source": "brain_signals_briefing_change_point_absorption", "target": "brain_signals_briefing_proactive_briefing", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brain/signals/briefing.md", "source_location": "line 5", "weight": 1.0}, {"source": "brain_signals_briefing_change_point_absorption", "target": "brain_signals_change_point_a13_change_point_detection", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brain/signals/briefing.md", "source_location": "line 5", "weight": 1.0}, {"source": "brain_signals_briefing_correlational_attribution", "target": "brain_signals_briefing_proactive_briefing", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brain/signals/briefing.md", "source_location": "line 5", "weight": 1.0}, {"source": "brain_signals_briefing_dormant_closure_exclusion", "target": "brain_signals_briefing_proactive_briefing", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brain/signals/briefing.md", "source_location": "line 22", "weight": 1.0}, {"source": "brain_signals_briefing_dormant_closure_exclusion", "target": "brain_signals_change_point_trt_closure_break", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "brain/signals/briefing.md", "source_location": "lines 13,22", "weight": 1.0}], "hyperedges": [{"id": "briefing_signal_composition", "label": "Signals composed into the daily briefing feed", "nodes": ["brain_signals_briefing_proactive_briefing", "brain_signals_change_point_a13_change_point_detection", "brain_signals_stock_inventory_a12_days_of_cover", "brain_signals_briefing_sop_kb_gap_signal", "brain_signals_briefing_cha