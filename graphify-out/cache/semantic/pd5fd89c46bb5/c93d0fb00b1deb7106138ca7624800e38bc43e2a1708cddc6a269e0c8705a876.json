{"nodes": [{"id": "brain_requirements_eval_evaluation_venv", "label": "brain/.venv-eval evaluation environment", "file_type": "rationale", "source_file": "brain/requirements-eval.txt", "source_location": "lines 1-11", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Evaluation-only deps are kept in a SEPARATE venv on Python 3.12 (never 3.13+, where torch/chronos/statsforecast/TSB-AD do not build) so the runtime venv stays untouched; the pipeline runs without them and the corresponding probes self-skip and say so when an import fails."}, {"id": "brain_requirements_eval_statsforecast", "label": "statsforecast (Croston/SBA cross-check oracle)", "file_type": "concept", "source_file": "brain/requirements-eval.txt", "source_location": "lines 13,19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pinned as the independent oracle for the WP2 G2.2 Croston/SBA cross-check rather than trusting the in-house implementation alone."}, {"id": "brain_requirements_eval_chronos_forecasting", "label": "chronos-forecasting 2.x + torch CPU (Rung-4 zero-shot eval)", "file_type": "concept", "source_file": "brain/requirements-eval.txt", "source_location": "lines 14-16,21-22", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Version floor is 2.2 because Chronos2Pipeline only exists in 2.x; model is amazon/chronos-2 with autogluon/chronos-2-small as fallback, weights fetched from Hugging Face on first use."}, {"id": "brain_requirements_eval_tsb_ad", "label": "TSB-AD (pinned VUS-PR metric, WP5)", "file_type": "concept", "source_file": "brain/requirements-eval.txt", "source_location": "lines 17,24", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "TSB-AD 1.5 is the pinned source of the reported VUS-PR; WP10 computes the metric from it, so the metric's provenance is a single pinned implementation."}, {"id": "brain_requirements_eval_vus_fallback", "label": "vus>=0.0.6 fallback pin", "file_type": "rationale", "source_file": "brain/requirements-eval.txt", "source_location": "lines 25-29", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "vus has never published a 1.0 (PyPI tops out at 0.0.6), so the previous `vus>=1.0` made the whole file unresolvable and .venv-eval could never be built from its own spec (report 58). No reported number moves: the fallback has never once supplied the metric."}], "edges": [{"source": "brain_requirements_eval_evaluation_venv", "target": "brain_requirements_eval_statsforecast", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brain/requirements-eval.txt", "source_location": "lines 13,19", "weight": 1.0}, {"source": "brain_requirements_eval_evaluation_venv", "target": "brain_requirements_eval_chronos_forecasting", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brain/requirements-eval.txt", "source_location": "lines 14-16,21-22", "weight": 1.0}, {"source": "brain_requirements_eval_evaluation_venv", "target": "brain_requirements_eval_tsb_ad", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brain/requirements-eval.txt", "source_location": "lines 17,24", "weight": 1.0}, {"source": "brain_requirements_eval_vus_fallback", "target": "brain_requirements_eval_tsb_ad", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brain/requirements-eval.txt", "source_location": "lines 17,25-29", "weight": 1.0}, {"source": "brain_requirements_eval_vus_fallback", "target": "brain_requirements_eval_evaluation_venv", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brain/requirements-eval.txt", "source_location": "lines 25-29", "weight": 1.0}, {"source": "brain_requirements_eval_chronos_forecasting", "targ