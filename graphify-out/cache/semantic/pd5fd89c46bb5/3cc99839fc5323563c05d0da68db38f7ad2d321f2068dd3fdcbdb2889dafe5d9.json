{"nodes": [{"id": "brain_signals_change_point_a13_change_point_detection", "label": "A13 \u00b7 Change-point / regime-shift detection", "file_type": "document", "source_file": "brain/signals/change_point.md", "source_location": "lines 1-3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Complementary sustained-shift layer: point anomalies stay with /deviation/check, so the two layers do not compete for the same alert."}, {"id": "brain_signals_change_point_conformal_residual_stream", "label": "Standardised conformal residual stream z = (actual - DOW-median) / conformal half-band@90%", "file_type": "concept", "source_file": "brain/signals/change_point.md", "source_location": "line 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Standardising by the conformal half-band makes shift magnitudes comparable across venues with different scales."}, {"id": "brain_signals_change_point_cusum", "label": "Two-sided CUSUM detector (drift)", "file_type": "concept", "source_file": "brain/signals/change_point.md", "source_location": "line 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Paired with a persistence detector because CUSUM catches slow drift while k-of-n catches abrupt breaks; neither alone covers both regimes."}, {"id": "brain_signals_change_point_persistence_detector", "label": "k-of-n persistence detector (4/7, abrupt)", "file_type": "concept", "source_file": "brain/signals/change_point.md", "source_location": "lines 3,16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ellel is persistence-only because it is sparse and booking-driven, so CUSUM's drift assumption does not hold there (FLAG-CP2)."}, {"id": "brain_signals_change_point_bocpd_benchmark", "label": "BOCPD benchmark detector", "file_type": "concept", "source_file": "brain/signals/change_point.md", "source_location": "line 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kept as a benchmark rather than a production detector \u2014 it measures the two shipped detectors rather than serving alerts itself."}, {"id": "brain_signals_change_point_recalibration_loop", "label": "T4 recalibration loop \u2014 recalibration_needed flag", "file_type": "rationale", "source_file": "brain/signals/change_point.md", "source_location": "lines 5-6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A confirmed shift makes the learned normal (DOW baseline + conformal calibration set) stale from the onset; the minimum shipped behaviour is a flag plus a degraded-confidence note until 28 post-change days accrue. Automatic re-fit on the post-change window is deferred (FLAG-CP3)."}, {"id": "brain_signals_change_point_leakage_free_detection", "label": "Leakage-free expanding one-step-ahead detection on trading days", "file_type": "rationale", "source_file": "brain/signals/change_point.md", "source_location": "line 16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Expanding one-step-ahead evaluation keeps future data out of the detection decision; restricting to trading days stops closures reading as shifts."}, {"id": "brain_signals_change_point_trt_closure_break", "label": "Two River Taps closure as ground-truth structural break", "file_type": "concept", "source_file": "brain/signals/change_point.md", "source_location": "lines 14,16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The one shift with a known external cause, so it serves as the labelled positive against which detector latency (8 days, both detectors) is validated."}], "edges": [{"source": "brain_signals_change_point_a13_change_point_detection", "target": "brain_signals_briefing_correlational_attribution", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "conf