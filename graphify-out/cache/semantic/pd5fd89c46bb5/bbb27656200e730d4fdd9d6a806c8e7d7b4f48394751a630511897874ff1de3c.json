{"nodes": [{"id": "brain_log_60_r1_vus_pr_result_r1_vus_pr_supplement", "label": "R1 \u2014 VUS-PR detector supplement", "file_type": "document", "source_file": "brain/log/60_R1_vus_pr_result.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Run at the literature-conformance gate to give the Results chapter a defensible detection headline; no code change was needed because the metric library was already pinned."}, {"id": "brain_log_60_r1_vus_pr_result_vus_pr", "label": "VUS-PR (volume under the surface, precision-recall)", "file_type": "concept", "source_file": "brain/log/60_R1_vus_pr_result.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen over point-adjusted F1 because it is lag-tolerant, and the detector's own persistence gate delays an alarm by construction \u2014 point-wise F1 would charge that delay as error."}, {"id": "brain_log_60_r1_vus_pr_result_tsb_ad_library", "label": "TSB-AD 1.5 metric library (pinned)", "file_type": "concept", "source_file": "brain/log/60_R1_vus_pr_result.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The metric is never reimplemented locally; the pinned library is the single authority."}, {"id": "brain_log_60_r1_vus_pr_result_liu_elephant_2024", "label": "liu_elephant_2024 (VUS-PR robustness)", "file_type": "paper", "source_file": "brain/log/60_R1_vus_pr_result.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "brain_log_60_r1_vus_pr_result_lu_proactive_2024", "label": "lu_proactive_2024 (proactive agents over-offer)", "file_type": "paper", "source_file": "brain/log/60_R1_vus_pr_result.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "brain_log_60_r1_vus_pr_result_d_f2", "label": "