location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recorded, not fixed: changing an artefact path was outside this gate's authorisation. Same class as the artefact-path defect report 58 found in the test suite."}, {"id": "brain_log_60_r1_vus_pr_result_venv_dependency_blocker_was_wrong", "label": "The 'dependency unavailable' blocker was an artefact of the wrong venv", "file_type": "rationale", "source_file": "brain/log/60_R1_vus_pr_result.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": ".venv-eval imports both vus and TSB_AD; .venv-run and .venv-forecast import neither, which is why the blocker kept reading as real."}], "edges": [{"source": "brain_log_60_r1_vus_pr_result_r1_vus_pr_supplement", "target": "brain_log_60_r1_vus_pr_result_vus_pr", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brain/log/60_R1_vus_pr_result.md", "source_location": null, "weight": 1.0}, {"source": "brain_log_60_r1_vus_pr_result_r1_vus_pr_supplement", "target": "brain_log_60_r1_vus_pr_result_d_f2", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brain/log/60_R1_vus_pr_result.md", "source_location": null, "weight": 1.0}, {"source": "brain_log_60_r1_vus_pr_result_r1_vus_pr_supplement", "target": "brain_log_60_r1_vus_pr_result_d_f2", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brain/log/60_R1_vus_pr_result.md", "source_location": null, "weight": 1.0}, {"source": "brain_log_60_r1_vus_pr_result_r1_vus_pr_supplement", "target": "brain_log_60_r1_vus_pr_result_w25", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brain/log/60_R1_vus_pr_result.md", "source_location": null, "weight": 1.0}, {"source": "brain_log_60_r1_vus_pr_result_vus_pr", "target": "brain_log_60_r1_vus_pr_result_tsb