{"nodes": [{"id": "brain_signals_weather_diagnostic_a14b_diagnostic", "label": "A14b \u00b7 Weather/calendar signal diagnostic (diagnostic only)", "file_type": "document", "source_file": "brain/signals/weather_diagnostic.md", "source_location": "lines 1-3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Asks whether the A14 L1 null hides a real category-level signal or weather is genuinely redundant-with-season. Explicitly diagnostic: nothing is adopted and the live ladder is unchanged."}, {"id": "brain_signals_weather_diagnostic_test_a_aggregation", "label": "Test A \u2014 L2/L3 weather ablation (aggregation hypothesis)", "file_type": "concept", "source_file": "brain/signals/weather_diagnostic.md", "source_location": "lines 5-12,39", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Weather clears the MASE+coverage bar at L2:Spirits, L3:Cider-BH and L3:Lager-BH \u2014 a localised, forecast-useful signal that L1 aggregation hides."}, {"id": "brain_signals_weather_diagnostic_test_b_physiology_matched", "label": "Test B \u2014 physiology-matched weather features (beer_garden_day, temp_anomaly)", "file_type": "concept", "source_file": "brain/signals/weather_diagnostic.md", "source_location": "lines 14-22,40", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Raw weather (0.903) beats baseline 0.977 while the engineered forms do not; exo_temp_anomaly is fragile on ~1 summer of climatology (FLAG-WD1), so the beer_garden_day threshold is weighted more."}, {"id": "brain_signals_weather_diagnostic_test_c_transition_folds", "label": "Test C \u2014 calendar on transition-aware folds", "file_type": "concept", "source_file": "brain/signals/weather_diagnostic.md", "source_location": "lines 24-27,41", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fold provenance matters (FLAG-WD3): a flat result on folds centred on term-vacation boundaries where the flag actually varies is real evidence the calendar is uninformative, whereas a flat result on A14's operational folds was not."}, {"id": "brain_signals_weather_diagnostic_test_d_residual_regression", "label": "Test D \u2014 residual-on-weather OLS with AR partialled out (model-independent)", "file_type": "concept", "source_file": "brain/signals/weather_diagnostic.md", "source_location": "lines 29-36,42", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Called decisive because it is model-independent: incremental R-squared of weather over AR/season is >0 and significant at L1 (+0.042) and L3:Cider-BH (+0.023) on exo_temp_c, so weather is NOT purely redundant-with-season."}, {"id": "brain_signals_weather_diagnostic_candidate_adoption", "label": "Weather logged as a strong CANDIDATE for separate gated adoption", "file_type": "rationale", "source_file": "brain/signals/weather_diagnostic.md", "source_location": "lines 44-46", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A real, forecast-useful signal was both localised and shown statistically significant, but adoption would need a covariate-aware model (TFT / TabPFN-TS, not a univariate foundation model) and its own gate, so nothing is adopted in this phase (FLAG-WD1..WD4)."}], "edges": [{"source": "brain_signals_weather_diagnostic_a14b_diagnostic", "target": "brain_signals_feature_ablation_a14_feature_ablation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brain/signals/weather_diagnostic.md", "source_location": "lines 1-3,25", "weight": 1.0}, {"source": "brain_signals_weather_diagnostic_a14b_diagnostic", "target": "brain_signals_feature_ablation_leadmatched_basis", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brain/signals/weather_diagnostic.md", "source_location": "line 3", "weight": 1.0}, {