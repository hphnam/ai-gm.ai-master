{"nodes": [{"id": "brain_log_75_native_interval_replication_result_native_interval_probe", "label": "eval/native_interval_probe.py", "file_type": "code", "source_file": "brain/log/75_native_interval_replication_result.md", "source_location": "lines 11-16", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scores the models' own quantiles on the same rolling origins/horizon/min-train as eval.interval_calibration; fits no conformal band and changes no served artefact."}, {"id": "brain_log_75_native_interval_replication_result_kaas_probabilistic_2026", "label": "kaas_probabilistic_2026 (published interval benchmark)", "file_type": "paper", "source_file": "brain/log/75_native_interval_replication_result.md", "source_location": "line 3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "brain_log_75_native_interval_replication_result_chronos_bolt_clamp", "label": "Chronos-Bolt 90% interval clamp", "file_type": "concept", "source_file": "brain/log/75_native_interval_replication_result.md", "source_location": "lines 18-34", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Trained on deciles 0.1-0.9; a 0.05/0.95 request silently clamps to the 80% interval with only a warning. The 0.90 row is reported as UNAVAILABLE rather than as a coverage failure, because reporting it would be measuring the clamp."}, {"id": "brain_log_75_native_interval_replication_result_magnitude_not_replicated", "label": "Published magnitude does not replicate", "file_type": "concept", "source_file": "brain/log/75_native_interval_replication_result.md", "source_location": "lines 36-53", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chronos-Bolt covers 0.816/0.862/0.772 against nominal 0.80; the only shortfall is 0.028, not the 0.28 the published 0.6211 would suggest. Reported first rather than buried under the part that did replicate."}, {"id": "brain_log_75_native_interval_replication_result_ordering_replicates", "label": "Ordering replicates three venues out of three", "file_type": "concept", "source_file": "brain/log/75_native_interval_replication_result.md", "source_location": "lines 55-70", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chronos-2 better calibrated and better on interval pinball everywhere, Chronos-Bolt narrower everywhere \u2014 the same sharpness-for-calibration trade. Rank agreement across a different domain, country, scale and frequency is worth more than a magnitude, because magnitudes are what should not transfer."}, {"id": "brain_log_75_native_interval_replication_result_zero_mass_masking", "label": "Ellel zero-mass coverage masking", "file_type": "concept", "source_file": "brain/log/75_native_interval_replication_result.md", "source_location": "lines 72-99", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pooled coverage 0.8956 hides active-only 0.4472; the pooled figure is carried by the 84% of rows where y is zero and any interval containing zero is free. The pooled-minus-active gap tracks the zero rate at all three venues."}, {"id": "brain_log_75_native_interval_replication_result_instrument_independence", "label": "Confirmation across a change of instrument", "file_type": "rationale", "source_file": "brain/log/75_native_interval_replication_result.md", "source_location": "lines 94-99", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "log/74 used conformal residuals + a Mondrian partition + an ETS point model; this probe uses a foundation model's own quantiles with no calibration layer. Same venue, direction and cause on a construction sharing nothing \u2014 so the finding is not an artefact of how the band was built."}, {"id": "brain_log_75_native_interval_replication_result_native_vs_conformal_temptation", "label": "Native-vs-conformal comparison withheld", "file_type": "rationale", "source_file": "brain/log/75_native_interval_replication_result.md", "source_location": "lines 101-111", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chronos-2's native 90% covers 0.9178 at the Beer Hall against the served band's 0.871, but the two differ in point model AND band construction AND whether a calibration layer exists, so the comparison identifies nothing. Deferred to Further Work with its own gate."}, {"id": "brain_log_75_native_interval_replication_result_tabpfn_abort_reason", "label": "TabPFN rung abort was not a compute limit", "file_type": "rationale", "source_file": "brain/log/75_native_interval_replication_result.md", "source_location": "lines 113-122", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "At this estate's scale the published 1607.9 ms vs 81.6 ms ratio is tens of minutes, not days. The reason was and remains that the data may not leave the machine; the write-up must not leave a reader free to supply the compute explanation."}], "edges": [{"source": "brain_log_75_native_interval_replication_result_native_interval_probe", "target": "brain_log_75_native_interval_replication_result_kaas_probabilistic_2026", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brain/log/75_native_interval_replication_result.md", "source_location": "lines 3-9", "weight": 1.0}, {"source": "brain_log_75_native_interval_replication_result_chronos_bolt_clamp", "target": "brain_log_75_native_interval_replication_result_kaas_probabilistic_2026", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brain/log/75_native_interval_replication_result.md", "source_location": "lines 26-34", "weight": 1.0}, {"source": "brain_log_75_native_interval_replication_result_native_interval_probe", "target": "brain_log_75_native_interval_replication_result_magnitude_not