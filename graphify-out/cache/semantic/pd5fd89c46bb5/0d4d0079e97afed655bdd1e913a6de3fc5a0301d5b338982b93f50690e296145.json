{"nodes": [{"id": "brain_eval_change_point_eval_change_point_validation", "label": "A13 \u00b7 Change-point detector validation", "file_type": "document", "source_file": "brain/eval/change_point_eval.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Honest characterisation against ground truth plus synthetic injection; the operating point is reported, not asserted."}, {"id": "brain_eval_change_point_eval_cusum_arl0", "label": "CUSUM ARL\u2080 operating point (k=0.5, h=5.0)", "file_type": "concept", "source_file": "brain/eval/change_point_eval.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Empirical ARL\u2080 exceeds the 400-day simulation horizon at every h tested (right-censored), so h=5.0 produces essentially no false alarms. The binding constraint is detection delay, not false-alarm rate; h=5.0 is retained deliberately under the project's false-alarm thesis, honest for a small single-venue sample."}, {"id": "brain_eval_change_point_eval_persistence_k_of_n", "label": "Persistence (k-of-n) confirmation rule", "file_type": "concept", "source_file": "brain/eval/change_point_eval.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "brain_eval_change_point_eval_bocpd_benchmark", "label": "BOCPD benchmark", "file_type": "concept", "source_file": "brain/eval/change_point_eval.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Kept as the principled benchmark but not shipped: a manager acts on '9 of 13 days below band since 12 May', not a run-length posterior, so CUSUM+persistence stays the production signal."}, {"id": "brain_eval_change_point_eval_synthetic_injection", "label": "Synthetic level-shift injection (detection delay vs false alarms)", "file_type": "concept", "source_file": "brain/eval/change_point_eval.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Larger \u03b4 detects faster and surer; lower h detects faster but admits more false alarms. A 0.5-band-unit shift sits near the noise floor and detects slowly \u2014 reported as an honest limit rather than tuned away."}, {"id": "brain_eval_change_point_eval_flag_cp1", "label": "FLAG-CP1 (CUSUM threshold calibration)", "file_type": "concept", "source_file": "brain/eval/change_point_eval.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "brain_eval_change_point_eval_change_point_validation", "target": "brain_eval_change_point_eval_cusum_arl0", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brain/eval/change_point_eval.md", "source_location": null, "weight": 1.0}, {"source": "brain_eval_change_point_eval_change_point_validation", "target": "brain_eval_change_point_eval_synthetic_injection", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brain/eval/change_point_eval.md", "source_location": null, "weight": 1.0}, {"source": "brain_eval_change_point_eval_change_point_validation", "target": "brain_eval_change_point_eval_persistence_k_of_n", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brain/eval/change_point_eval.md", "source_location": null, "weight": 1.0}, {"source": "brain_eval_change_point_eval_change_point_validation", "target": "brain_eval_change_point_eval_bocpd_benchmark", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brain/eval/change_point_eval.md", "source_location": null, "weight": 1.0}, {"source": "brain_eval_change_point_eval_cusum_arl0", "target": "brain_eval_change_point_eval_flag_cp1", "relation": "references", "confidence": "EXTRACTED", "confidence_