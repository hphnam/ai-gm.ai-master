{"nodes": [{"id": "brain_ledger_citation_audit_citation_audit", "label": "Citation Audit \u2014 84 Keys Across Three Chapters", "file_type": "document", "source_file": "brain/ledger/citation_audit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Read-only: no chapter was modified in either pass. Every key checked three ways \u2014 presence in ref.bib, the sentence captured verbatim, and whether the source supports that specific claim."}, {"id": "brain_ledger_citation_audit_verdict_vocabulary", "label": "Verdict Vocabulary (SUPPORTED / OVERSTATED / UNSUPPORTED / WRONG-SOURCE / MISSING-KEY)", "file_type": "concept", "source_file": "brain/ledger/citation_audit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "brain_ledger_citation_audit_unverified_verdict_tag", "label": "The UNVERIFIED Tag, Added Mid-Audit", "file_type": "rationale", "source_file": "brain/ledger/citation_audit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The brief's five verdicts could not express what kept happening; recording an unretrievable source as SUPPORTED would reproduce exactly the defect of asserting a verification pass that did not happen."}, {"id": "brain_ledger_citation_audit_second_pass_zotero_fulltext", "label": "Second Pass \u2014 Re-verification Against Zotero Full Text", "file_type": "concept", "source_file": "brain/ledger/citation_audit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The eleven unverified claims were verifiable, just not in NotebookLM; the sources that could not be checked were not merely unchecked, they were hiding three real defects."}, {"id": "brain_ledger_citation_audit_nine_overstated", "label": "The Nine OVERSTATED Keys", "file_type": "concept", "source_file": "brain/ledger/citation_audit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "brain_ledger_citation_audit_one_wrong_source", "label": "The One WRONG-SOURCE", "file_type": "concept", "source_file": "brain/ledger/citation_audit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The clause carries no citation of its own, which makes it an unsourced comparative number in prose."}, {"id": "brain_ledger_citation_audit_missing_key_provenance_check", "label": "MISSING-KEY Provenance Check", "file_type": "rationale", "source_file": "brain/ledger/citation_audit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MISSING-KEY is defined against ref.bib, not against the library, and the check behind it was a full inventory rather than a per-key library query, so the Zotero tooling defect cannot have produced a false negative here."}], "edges": [{"source": "brain_ledger_citation_audit_citation_audit", "target": "brain_ledger_citation_audit_verdict_vocabulary", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brain/ledger/citation_audit.md", "source_location": null, "weight": 1.0}, {"source": "brain_ledger_citation_audit_citation_audit", "target": "brain_ledger_citation_audit_unverified_verdict_tag", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brain/ledger/citation_audit.md", "source_location": null, "weight": 1.0}, {"source": "brain_ledger_citation_audit_citation_audit", "target": "brain_ledger_citation_audit_second_pass_zotero_fulltext", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brain/ledger/citation_audit.md", "source_location": null, "weight": 1.0}, {"source": "brain_ledger_citation_audit_citation_audit", "target": "brain_ledger_citation_aud