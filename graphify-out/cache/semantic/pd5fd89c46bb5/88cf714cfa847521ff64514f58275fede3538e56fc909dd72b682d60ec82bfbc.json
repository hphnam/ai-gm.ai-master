{"nodes": [{"id": "brain_hierarchy_reconciliation_forecast_a6_hierarchical_reconciliation", "label": "A6 Hierarchical Reconciliation (Beer Hall, 41 nodes)", "file_type": "document", "source_file": "brain/hierarchy/reconciliation_forecast.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Run for the Beer Hall only: Two River Taps is closed and Ellel is booking-driven at ~64 trading days, so their category/item splits would be sparser than the Beer Hall's already-under-covering item bands."}, {"id": "brain_hierarchy_reconciliation_forecast_wls_v_reconciliation", "label": "WLS_v Reconciliation (Wickramasuriya Eq. 11, diagonal W)", "file_type": "rationale", "source_file": "brain/hierarchy/reconciliation_forecast.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Named WLS_v rather than MinT because those authors reserve 'MinT' for the off-diagonal Sample/Shrink estimators; using the name for a diagonal W would misattribute the method."}, {"id": "brain_hierarchy_reconciliation_forecast_robust_dow_median_base", "label": "Robust DOW-Median Base Forecaster at L2/L3", "file_type": "rationale", "source_file": "brain/hierarchy/reconciliation_forecast.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The rung-climbing discipline applied at L1 was deliberately not repeated: ~30 item series are too sparse for ETS/GBM without overfitting, and the coherence guarantee depends on the summing matrix, not on base-forecaster sophistication. A better base would tighten bands, not change coherence."}, {"id": "brain_hierarchy_reconciliation_forecast_coherence_check", "label": "Coherence Check (sum item = category = venue)", "file_type": "concept", "source_file": "brain/hierarchy/reconciliation_forecast.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "brain_hierarchy_reconciliation_forecast_unbiasedness_precondition", "label": "Base-Forecast Unbiasedness Precondition", "file_type": "concept", "source_file": "brain/hierarchy/reconciliation_forecast.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Measured rather than assumed via a per-node one-sample t-test on the held-out calibration block. 22 of 41 nodes reject; the MinT optimality claim is reported as conditional on a condition these nodes do not meet."}, {"id": "brain_hierarchy_reconciliation_forecast_reconciled_band_coverage", "label": "Reconciled-Band Coverage (L2 vs L3)", "file_type": "concept", "source_file": "brain/hierarchy/reconciliation_forecast.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One band-construction path serves both the coverage check and persistence, so no separate parametric band can disagree with the served one."}, {"id": "brain_hierarchy_reconciliation_forecast_croston_sba_contest", "label": "Croston/SBA vs DOW-Median Contest (WP2)", "file_type": "concept", "source_file": "brain/hierarchy/reconciliation_forecast.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "0 of 16 intermittent nodes adopted an intermittent estimator; TEST columns are reported, never selected on."}, {"id": "brain_hierarchy_reconciliation_forecast_one_standard_error_margin", "label": "One-Standard-Error Adoption Margin", "file_type": "rationale", "source_file": "brain/hierarchy/reconciliation_forecast.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pre-registered before implementation, after observing that the bare inequality adopted a node on a 0.21% margin which then scored 96% worse on test; the ordering is stated rather than concealed. Disjoint 7-day sub-blocks avoid the serial correlation that biases a daily standard error downward."}, {"id": "brain_hierarchy_reconciliation_forecast_kostenko_hyndman_rule", "label": "Kostenko-Hyndman Selection Rule (cv2 > 2 - 1.5*adi)", "file_type": "concept", "source_file": "brain/hierarchy/reconciliation_forecast.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "brain_hierarchy_reconciliation_forecast_stock_consumption_proxy", "label": "Stock-Consumption Proxy (Lager - BH)", "file_type": "concept", "source_file": "brain/hierarchy/reconciliation_forecast.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "brain_hierarchy_reconciliation_forecast_a12_stock_cover_join", "label": "A12 Inventory-Aware Reorder Join (days_of_cover)", "file_type": "concept", "source_file": "brain/hierarchy/reconciliation_forecast.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lines whose brand is not a forecast A6 node are omitted rather than guessed: a NULL demand is reported as NULL."}, {"id": "brain_hierarchy_reconciliation_forecast_runtime_identity", "label": "Runtime Identity and Store Ceiling Stamp", "file_type": "concept", "source_file": "brain/hierarchy/reconciliation_forecast.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "brain_hierarchy_reconciliation_forecast_a6_hierarchical_reconciliation", "target": "brain_hierarchy_reconciliation_forecast_wls_v_reconciliation", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brain/hierarchy/reconciliation_forecast.md", "source_location": null, "weight": 1.0}, {"source": "brain_hierarchy_reconciliation_forecast_a6_hierarchical_reconciliation", "target": "brain_hierarchy_reconciliation_forecast_robust_dow_me