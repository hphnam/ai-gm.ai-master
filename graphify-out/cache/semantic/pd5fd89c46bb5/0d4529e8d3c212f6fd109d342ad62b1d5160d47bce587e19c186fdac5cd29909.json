{"nodes": [{"id": "brain_knowledge_06_research_questions_research_questions", "label": "The Five Research Questions (APPROVED, closed)", "file_type": "document", "source_file": "brain/knowledge/06_research_questions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "brain_knowledge_06_research_questions_project_aim", "label": "The Aim \u2014 Whether Three Venues Hold Enough Data", "file_type": "concept", "source_file": "brain/knowledge/06_research_questions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The project specification's question narrowed to what the evidence can settle; the narrowing is declared in Discussion 5.5 under HC59 rather than left implicit."}, {"id": "brain_knowledge_06_research_questions_three_admission_constraints", "label": "C1-C3 \u2014 The Three Admission Constraints", "file_type": "rationale", "source_file": "brain/knowledge/06_research_questions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "C1 rejects any question motivated by a PRJ93 observation, so the thirty-eight excised passages cannot be smuggled back as question motivation; C2 rejects questions blocked on a third party; C3 rejects grains Chapter 5 cannot answer directly."}, {"id": "brain_knowledge_06_research_questions_rq1_model_separation_and_origins", "label": "RQ1 \u2014 Separability of Forecasting Approaches and Origin Count", "file_type": "concept", "source_file": "brain/knowledge/06_research_questions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "brain_knowledge_06_research_questions_rq2_demand_structure_and_reconciliation", "label": "RQ2 \u2014 Intermittency, Hierarchy and the Point-Forecast Estimand", "file_type": "concept", "source_file": "brain/knowledge/06_research_questions.md", "source_