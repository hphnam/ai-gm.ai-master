{"nodes": [{"id": "brain_signals_stock_inventory_a12_days_of_cover", "label": "A12 \u00b7 Stock inventory days-of-cover reorder signal", "file_type": "document", "source_file": "brain/signals/stock_inventory.md", "source_location": "lines 1-6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Joins physical on-hand kegs to the A6 reconciled demand forecast. Beer Hall only because no TRT/Ellel stock sheets exist (FLAG-5)."}, {"id": "brain_signals_stock_inventory_level_not_flow", "label": "Stock is a level, not a flow (FLAG-2)", "file_type": "rationale", "source_file": "brain/signals/stock_inventory.md", "source_location": "lines 3,30", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stock is a monthly level, so consumption is taken from the sales-side A6 forecast and never inferred from stock differences, which would confound deliveries, wastage and count timing."}, {"id": "brain_signals_stock_inventory_reorder_rule", "label": "Reorder rule: days_of_cover < lead(3) + safety(2)", "file_type": "concept", "source_file": "brain/signals/stock_inventory.md", "source_location": "lines 5,31", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Order target extends 7 days beyond cover. Lead and safety days are declared working assumptions for the owner to confirm per beer (FLAG-3), not measured values."}, {"id": "brain_signals_stock_inventory_keg_to_pints", "label": "Size-aware keg-to-pints conversion (30 L -> 52.8, 50 L/unknown -> 88)", "file_type": "concept", "source_file": "brain/signals/stock_inventory.md", "source_location": "lines 5,32", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Refines A6's flat 88 pints/keg assumption (FLAG-4); the 50 L value is retained as the default for unknown container sizes."}, {"id": "brain_signals_stock_inventory_null_demand_scope", "label": "NULL-demand lines surfaced as on-hand only, never a guessed cover", "file_type": "rationale", "source_file": "brain/signals/stock_inventory.md", "source_location": "line 12", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only 1 of 14 core keg/cask lines maps to an A6 forecast node; the other 13 have no single mapped sales item or sit outside A6's top-k node set. The signal is exact where demand is known and silent where it is not."}, {"id": "brain_signals_stock_inventory_working_capital", "label": "Working-capital inefficiency targeted by the cover signal", "file_type": "rationale", "source_file": "brain/signals/stock_inventory.md", "source_location": "lines 14-15", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mean inventory GBP 6803 (CV 0.34) with kegs swinging 11 -> 66 across months and no smooth trend indicates reactive bulk-ordering; the signal converts 'order when the cellar looks empty' into 'order N kegs of X by <date>'."}, {"id": "brain_signals_stock_inventory_dead_stock_candidates", "label": "Dead-stock / dead-listing candidates", "file_type": "concept", "source_file": "brain/signals/stock_inventory.md", "source_location": "lines 17-27", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Low mean quantity across many snapshots (or a single snapshot at high price) flags lines that occupy capital without turning."}, {"id": "brain_signals_stock_inventory_stale_footer_flag", "label": "Hand-typed footers stale; line-item sums authoritative (FLAG-6)", "file_type": "rationale", "source_file": "brain/signals/stock_inventory.md", "source_location": "lines 34-35", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Feb/Apr/May footers are occasionally stale, so totals are recomputed from line items; the median keg-cost rise is mix-confounded and reported as indicative only (FLAG-7)."}], "edges": [{"source": "brain_signals_