{"nodes": [{"id": "_claude_skills_scientific_writing_skill_imrad", "label": "IMRAD structure", "file_type": "concept", "source_file": ".claude/skills/scientific-writing/SKILL.md", "source_location": "lines 16-21", "source_url": null, "captured_at": null, "author": "researchclaw", "contributor": null, "rationale": "Introduction funnels from broad context to gap to contribution; Results present findings without interpretation so the Discussion carries all the interpreting."}, {"id": "_claude_skills_scientific_writing_skill_paragraph_guidance", "label": "Paragraph-level guidance", "file_type": "concept", "source_file": ".claude/skills/scientific-writing/SKILL.md", "source_location": "lines 23-28", "source_url": null, "captured_at": null, "author": "researchclaw", "contributor": null, "rationale": "One idea per paragraph, full flowing prose never bullet points in final text, active voice, 15-25 words per sentence on average."}, {"id": "_claude_skills_scientific_writing_skill_citation_practices", "label": "Citation best practices", "file_type": "concept", "source_file": ".claude/skills/scientific-writing/SKILL.md", "source_location": "lines 30-35", "source_url": null, "captured_at": null, "author": "researchclaw", "contributor": null, "rationale": "Primary sources over reviews for specific claims; no citation strings of 5+; every factual claim cited unless it is common knowledge in the field."}, {"id": "_claude_skills_scientific_writing_skill_writing_pitfalls", "label": "Common writing pitfalls", "file_type": "concept", "source_file": ".claude/skills/scientific-writing/SKILL.md", "source_location": "lines 37-42", "source_url": null, "captured_at": null, "author": "researchclaw", "contributor": null, "rationale": "No hedge-stacking, no 'it is well known that', and 'significant' (statistical) kept distinct from 'substantial' (practical)."}, {"id": "_claude_skills_scientific_writing_skill_reporting_guidelines", "label": "Reporting guidelines (CONSORT/STROBE/PRISMA/STARD)", 