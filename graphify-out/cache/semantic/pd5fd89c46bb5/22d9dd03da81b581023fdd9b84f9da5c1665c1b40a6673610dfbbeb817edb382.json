{"nodes": [{"id": "brain_ledger_main_preamble_diff_main_preamble_additions", "label": "main.tex Preamble Additions, Applied", "file_type": "document", "source_file": "brain/ledger/main_preamble_diff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Additive only, nothing removed or reordered; the command forms were used rather than package options so the existing algo2e option is left untouched."}, {"id": "brain_ledger_main_preamble_diff_algo2e_option_defect", "label": "The algo2e Environment-Rename Defect", "file_type": "concept", "source_file": "brain/ledger/main_preamble_diff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "main.tex loads algorithm2e with the algo2e option so it can coexist with the algorithm package, and that option renames the environment; three floats opening \\begin{algorithm} would have opened the other package's float and every body command inside would have failed."}, {"id": "brain_ledger_main_preamble_diff_assert_against_the_target", "label": "Assert Against the Target, Not the Harness", "file_type": "rationale", "source_file": "brain/ledger/main_preamble_diff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A proof that passes while the document fails is worse than no proof: it converts an open question into a false answer. The compile proof loaded algorithm2e alone, so the page would have compiled clean while the document broke."}, {"id": "brain_ledger_main_preamble_diff_figure_proof_tex", "label": "figure_proof.tex \u2014 the Compile Proof Harness", "file_type": "concept", "source_file": "brain/ledger/main_preamble_diff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Now reproduces main.tex's package block, not only its class, size, leading and margins."}, {"id": "brain_ledger_main_preamble_diff_stale_reading_correction", "label": "The Prepared Diff Was Written From a Stale Reading", "file_type": "concept", "source_file": "brain/ledger/main_preamble_diff.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two of its three claimed additions were already present; the \\mathbf{1} substitution existed to work around a package that was never absent."}], "edges": [{"source": "brain_ledger_main_preamble_diff_main_preamble_additions", "target": "brain_ledger_main_preamble_diff_algo2e_option_defect", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brain/ledger/main_preamble_diff.md", "source_location": null, "weight": 1.0}, {"source": "brain_ledger_main_preamble_diff_main_preamble_additions", "target": "brain_ledger_main_preamble_diff_assert_against_the_target", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brain/ledger/main_preamble_diff.md", "source_location": null, "weight": 1.0}, {"source": "brain_ledger_main_preamble_diff_main_preamble_additions", "target": "brain_ledger_main_preamble_diff_figure_proof_tex", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brain/ledger/main_preamble_diff.md", "source_location": null, "weight": 1.0}, {"source": "brain_ledger_main_preamble_diff_main_preamble_additions", "target": "brain_ledger_main_preamble_diff_stale_reading_correction", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brain/ledger/main_preamble_diff.md", "source_location": null, "weight": 1.0}, {"source": "brain_ledger_main_preamble_diff_algo2e_option_defect", "target": "brain_ledger_main_preamble_diff_assert_against_the_target", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brain/ledger/main_preamble_diff.md", "so