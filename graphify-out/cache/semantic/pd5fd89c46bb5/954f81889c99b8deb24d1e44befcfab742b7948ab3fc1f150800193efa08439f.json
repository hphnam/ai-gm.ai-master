{"nodes": [{"id": "brain_drafts_figures_gap_map_gap_map", "label": "fig:gap-map \u2014 proactive-agent evaluation gap map", "file_type": "image", "source_file": "brain/drafts/figures/gap_map.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A 4x3 positioning grid: rows are the intervention policy a system runs, columns are what its decisions are finally scored against, ordered by how directly the grounding is a real person's judgement. Every cell is drawn faint except the empty top-right cell, drawn in ink and labelled 'this dissertation' \u2014 the empty cell IS the argument."}, {"id": "brain_drafts_figures_gap_map_evaluation_grounding_axis", "label": "Evaluation-grounding axis (LM judge / simulated users / annotated corpora / operator decisions)", "file_type": "concept", "source_file": "brain/drafts/figures/gap_map.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "brain_drafts_figures_gap_map_intervention_policy_axis", "label": "Intervention-policy axis (accuracy/F1 \u2192 cost-asymmetric threshold \u2192 elicited cost ratio with measured gate calibration)", "file_type": "concept", "source_file": "brain/drafts/figures/gap_map.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "brain_drafts_figures_gap_map_prism", "label": "PRISM (cost-asymmetric acceptance-probability gate)", "file_type": "concept", "source_file": "brain/drafts/figures/gap_map.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Placed alone in the middle row: the only surveyed system gating on a calibrated acceptance probability rather than accuracy alone, but it reports the gate's effect and not the calibration of the probability the gate depends on."}, {"id": "brain_drafts_figures_gap_map_operator_grounded_evaluation_gap",