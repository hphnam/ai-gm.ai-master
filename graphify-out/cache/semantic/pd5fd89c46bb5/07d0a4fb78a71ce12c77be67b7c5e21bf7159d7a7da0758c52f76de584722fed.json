{"nodes": [{"id": "brain_knowledge_01_autoresearchclaw_reference_autoresearchclaw_pipeline", "label": "AutoResearchClaw 23-Stage Pipeline", "file_type": "document", "source_file": "brain/knowledge/01_autoresearchclaw_reference.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Distilled for PRJ93 specifically to locate where human gates buy the most output quality, not to reimplement the system."}, {"id": "brain_knowledge_01_autoresearchclaw_reference_stage05_literature_screen", "label": "Stage 5 \u2014 LITERATURE_SCREEN (gate 1)", "file_type": "concept", "source_file": "brain/knowledge/01_autoresearchclaw_reference.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "brain_knowledge_01_autoresearchclaw_reference_stage08_hypothesis_gen", "label": "Stage 8 \u2014 HYPOTHESIS_GEN (three role agents + synthesiser)", "file_type": "concept", "source_file": "brain/knowledge/01_autoresearchclaw_reference.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "brain_knowledge_01_autoresearchclaw_reference_stage09_experiment_design", "label": "Stage 9 \u2014 EXPERIMENT_DESIGN (gate 2)", "file_type": "concept", "source_file": "brain/knowledge/01_autoresearchclaw_reference.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Highest-leverage gate: rejection discards the whole hypothesis and it sits upstream of every number the paper will contain. Nothing downstream can retrofit a control condition that was never run."}, {"id": "brain_knowledge_01_autoresearchclaw_reference_stage12_experiment_run", "label": "Stage 12 \u2014 EXPERIMENT_RUN", "file_type": "concept", "source_file": "brain/knowledge/01_autoresearchclaw_reference.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "brain_knowledge_01_autoresearchclaw_reference_stage13_iterative_refine", "label": "Stage 13 \u2014 ITERATIVE_REFINE", "file_type": "concept", "source_file": "brain/knowledge/01_autoresearchclaw_reference.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "brain_knowledge_01_autoresearchclaw_reference_stage14_result_analysis", "label": "Stage 14 \u2014 RESULT_ANALYSIS", "file_type": "concept", "source_file": "brain/knowledge/01_autoresearchclaw_reference.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "brain_knowledge_01_autoresearchclaw_reference_stage18_peer_review", "label": "Stage 18 \u2014 PEER_REVIEW", "file_type": "concept", "source_file": "brain/knowledge/01_autoresearchclaw_reference.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Advertised as multi-agent; it is one LLM call role-playing three reviewers. Three personas from one model in one context share every blind spot and cannot disagree in any load-bearing sense."}, {"id": "brain_knowledge_01_autoresearchclaw_reference_stage20_quality_gate", "label": "Stage 20 \u2014 QUALITY_GATE (gate 3)", "file_type": "concept", "source_file": "brain/knowledge/01_autoresearchclaw_reference.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "brain_knowledge_01_autoresearchclaw_reference_stage23_citation_verify", "label": "Stage 23 \u2014 CITATION_VERIFY", "file_type": "concept", "source_file": "brain/knowledge/01_autoresearchclaw_reference.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Runs after stage 22 has already compiled the PDF and never writes back, so the submittable .tex/.pdf keeps the hallucinated citations."}, {"id": "brain_knowledge_01_autoresearchclaw_reference_immutable_harness", "label": "Immutable Harness Pattern", "file_type": "rationale", "source_file": "brain/knowledge/01_autoresearchclaw_reference.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A file the generating model cannot edit is the sole writer of the canonical results artifact, so a generated experiment cannot report a number without going through code the model never sees."}, {"id": "brain_knowledge_01_autoresearchclaw_reference_fabrication_guards", "label": "Three Hard Fabrication Guards", "file_type": "concept", "source_file": "brain/knowledge/01_autoresearchclaw_reference.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only place the pipeline refuses to continue on evidentiary grounds; note the asymmetry that non-finite metrics are dropped at parse time, so the trigger is 'zero real metrics', not 'bad metrics'."}, {"id": "brain_knowledge_01_autoresearchclaw_reference_graceful_degradation_antipattern", "label": "graceful_degradation on the Only Hard Quality Stop", "file_type": "rationale", "source_file": "brain/knowledge/01_autoresearchclaw_reference.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Converts the pipeline's single hard quality stop into a footnote on the exported paper."}, {"id": "brain_knowledge_01_autoresearchclaw_reference_quality_signal_never_branched", "label": "Computing a Quality Signal and Never Branching on It", "file_type": "rationale", "source_file": "brain/knowledge/01_autoresearchclaw_reference.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The template failure mode of the whole system: it produces the appearance of rigour with none of the effect."}, {"id": "brain_knowledge_01_autoresearchclaw_reference_single_call_multi_persona_review", "label": "Single-Call Multi-Persona Review", "file_type": "rationale", "source_file": "brain/knowledge/01_autoresearchclaw_reference.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If a critique step matters the roles need separate calls; otherwise the personas share one context and one set of blind spots."}, {"id": "brain_knowledge_01_autoresearchclaw_reference_min_shortlist_backfill", "label": "Backfilling to Hit a Count (_MIN_SHORTLIST = 15)", "file_type": "rationale", "source_file": "brain/knowledge/01_autoresearchclaw_reference.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Backfilling from the pre-filtered pool with synthetic descending scores means the number 15 carries no information about how many papers passed screening."}, {"id": "brain_knowledge_01_autoresearchclaw_reference_evidence_bounding_prompt", "label": "Stage-17 Evidence-Bounding Prompt Block", "file_type": "concept", "source_file": "brain/knowledge/01_autoresearchclaw_reference.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If the experiment covers only partial conditions the title must use 'Toward\u2026'/'Investigating\u2026' rather than a global causal claim."}, {"id": "brain_knowledge_01_autoresearchclaw_reference_overleaf_sync_warning", "label": "OverleafSync Unconditional-Overwrite Hazard", "file_type": "rationale", "source_file": "brain/knowledge/01_autoresearchclaw_reference.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "push_paper copies local files over the remote working tree unconditionally with a conflict resolver defaulting to keeping the AI's version \u2014 exactly the design PRJ93's unconditional Overleaf gate exists to prevent."}, {"id": "brain_knowledge_01_autoresearchclaw_reference_hitl_gate_mechanisms", "label": "Two Independent HITL Gate Mechanisms", "file_type": "concept", "source_file": "brain/knowledge/01_autoresearchclaw_reference.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "brain_knowledge_01_autoresearchclaw_reference_unverified_negative", "label": "The 'Unverified Negative' Confidence Marker", "file_type": "rationale", "source_file": "brain/knowledge/01_autoresearchclaw_reference.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Absence found by grep is weaker evidence than presence, so a subagent that could not find a call site records an unverified negative rather than an absence."}], "edges": [{"source": "brain_knowledge_01_autoresearchclaw_reference_autoresearchclaw_pipeline", "target": "brain_knowledge_01_autoresearchclaw_reference_stage05_literature_screen", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brain/knowledge/01_autoresearchclaw_reference.md", "source_location": null, "weight": 1.0}, {"source": "brain_knowledge_01_autoresearchclaw_reference_autoresearchclaw_pipeline", "target": "brain_knowledge_01_autoresearchclaw_reference_stage08_hypothesis_gen", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brain/knowledge/01_autoresearchclaw_reference.md", "source_location": null, "weight": 1.0}, {"source": "brain_knowledge_01_autoresearchclaw_reference_autoresearchclaw_pipeline", "target": "brain_knowledge_01_autoresearchclaw_reference_stage09_experiment_design", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "brain/knowledge/01_autoresearchclaw_reference.md", "source_location": null, "weight": 1.0}, {"source": "brain_knowledge_01_autoresearchclaw_reference_autoresearchclaw_pipeline", "target": "brain_knowledge_01_autoresearchcl